# Rust build artifacts
target/
**/*.rs.bk

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.env.local
frontend/.env.*.local
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Stellar CLI keys (never commit private keys)
.stellar/
*.stellar-key

# Deployment manifests record live contract IDs, wasm hashes and git SHAs per
# network. They are runtime artifacts (generated by scripts/deploy.sh) and must
# never be committed — see docs/DEPLOYMENT.md.
deployments/*.json
# Throwaway verification worktrees / target dirs from scripts/verify-deployment.sh
/automint_verify_*
/automint_vb1_*
/automint_vb2_*

# Indexer (issue #563) — node_modules, compiled output, and the SQLite DB
# (which contains live indexed events + the poll checkpoint).
indexer/node_modules/
indexer/dist/
indexer/data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript build cache
frontend/tsconfig.tsbuildinfo

# Misc
*.log
*.tmp
.agents/
issue.md    
skills-lock.json