# AutoMint frontend environment variables
# Copy this file to .env.local and replace each placeholder with the
# values from the target Soroban deployment.

# Network badge / read-only source for anonymous visitors.
# Public network label shown by the frontend (for example: TESTNET or MAINNET).
NEXT_PUBLIC_NETWORK=TESTNET

# Public key used as the simulation source for read-only contract calls when
# no wallet is connected (anonymous visitors viewing the marketplace or
# leaderboard must still see listings/rankings).
#
# Requirements:
#   • Must be a real, funded testnet account (run Friendbot if needed:
#     curl "https://friendbot.stellar.org/?addr=<KEY>")
#   • Never used for signing or submission — only passed as the fee-source
#     account when simulating read-only calls via simulateTransaction.
#   • Leave blank during local development if you always connect a wallet.
#
# Example (deploy key funded via Friendbot):
#   NEXT_PUBLIC_SIMULATION_SOURCE=GABC...XYZ
NEXT_PUBLIC_SIMULATION_SOURCE=

# Soroban RPC endpoint used for transaction simulation and submission.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase used when signing transactions.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Registry contract ID for bot ownership and metadata lookup.
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX01

# Bot NFT contract ID for minting and reading bot NFT data.
NEXT_PUBLIC_BOT_NFT_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX02

# Accrual contract ID for points accrual and claim operations.
NEXT_PUBLIC_ACCRUAL_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX03

# Marketplace contract ID for listing, buying, and canceling bot sales.
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX04

# Token contract ID for the in-app payment/reward asset.
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX05

# Horizon URL for account and transaction queries.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Transaction tunables.
NEXT_PUBLIC_TX_TIMEOUT=30
NEXT_PUBLIC_BASE_FEE=100

# Points-to-AMT conversion threshold (points per 1 AMT).
NEXT_PUBLIC_POINTS_PER_AMT=1000

# Leaderboard pagination limit.
NEXT_PUBLIC_LEADERBOARD_LIMIT=50

# Polling interval when waiting for a transaction to complete (ms).
NEXT_PUBLIC_POLL_INTERVAL_MS=1000

# Tick interval used by the accrual counter (ms).
NEXT_PUBLIC_COUNTER_TICK_MS=1000

# ---------------------------------------------------------------------------
# Error reporting (Sentry)
# ---------------------------------------------------------------------------
# DSN from your Sentry project settings.  Leave blank to disable Sentry.
# No Stellar addresses or PII are ever transmitted — see docs/PRIVACY.md.
NEXT_PUBLIC_SENTRY_DSN=

# Deployment environment label shown in Sentry (e.g. development, staging, production).
NEXT_PUBLIC_APP_ENV=development

# Sentry auth token — required for source-map uploads during CI builds.
# NEVER commit this value; set it as a CI secret.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Product analytics
# ---------------------------------------------------------------------------
# Set to "true" to enable funnel event tracking (see docs/PRIVACY.md).
# Disabled by default — no analytics data is sent unless explicitly opted in.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
